{
  "name": "konradfedorczyk.dev",
  "type": "module",
  "version": "1.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview --port 4322",
    "build:preview": "SITE_URL=http://localhost:4322 astro build && astro preview --port 4322 --host",
    "build:production": "SITE_URL=https://konradfedorczyk.dev astro build",
    "astro": "astro",
    "deploy": "npm run build:production && node --env-file=.env scripts/deploy.mjs && node --env-file=.env scripts/purge-cache.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "astro": "^7.3.1",
    "astro-favicons": "^3.1.8",
    "nanostores": "^1.4.1",
    "sass": "^1.101.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@types/node": "^26.6.5",
    "@types/three": "^0.185.1",
    "basic-ftp": "^6.2.6",
    "cloudflare": "^7.3.0"
  }
}
