---
import Logo from "./Logo.astro";
import Container from "./Container.astro";
import Grid from "./Grid.astro";
import Menu from "./Menu.astro";
import HamburgerButton from "./HamburgerButton.astro";
import ThemeButtonClassic from "./ThemeButtonClassic.astro";
import OverlayMenu from "../components/OverlayMenu.astro";

const { ...props } = Astro.props;
---
<header {...props}>
  <Container>
    <Grid>
      <div class="left">
        <a
          href="/"
          aria-label="Konrad Fedorczyk - Home"
          rel="home"
          class="logo"
        >
          <Logo aria-hidden="true" />
        </a>
      </div>
      <div class="center">
        <Menu />
      </div>
      <div class="right">
        <div class="mobile-navigation">
          <HamburgerButton />
        </div>
        <div class="desktop-navigation">
          <ThemeButtonClassic />
        </div>
      </div>
    </Grid>
  </Container>
</header>
<style lang="scss">
  @use "sass:map";
  @use "../styles/breakpoints";

  /* ==========================================
   Global/Mobile
  =========================================== */
  header {
    border-top: 1px solid var(--color-primary);
    border-bottom: 1px solid var(--color-primary);
    border-left: 1px solid var(--color-primary);
    background-color: var(--color-secondary);
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    height: 64px;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
  }

  .logo {
    padding: 0 0 0 16px;
    border-left: 1px solid transparent;
    border-right: 1px solid transparent;
    height: 64px;
    display: flex;
    flex-direction: row;
    align-items: center;
    align-content: center;
  }

  // Responsive styling
  .left {
    grid-column: span 4;
    display: flex;
    height: 64px;
  }

  .center {
    grid-column: span 0;
    display: none;
  }

  .right {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-end;
    align-content: stretch;
    align-items: center;
    grid-column: span 2;
    height: 64px;
  }

  .desktop-navigation {
    display: none;
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    header {
      border-left: none;
      border-right: none;
      border-top: none;

      > :global(div) {
        padding: 0 var(--size-vertical-base);
      }
    }

    .mobile-navigation {
      display: none;
    }

    .desktop-navigation {
      display: initial;
      height: 64px;
    }

    .logo {
      padding: 0 var(--size-vertical-base);
    }

    .logo:hover {
      border-left: 1px solid var(--color-primary);
      border-right: 1px solid var(--color-primary);
    }

    .left {
      grid-column: span 1;
    }

    .right {
      grid-column: span 1;
    }

    .center {
      display: initial;
      grid-column: span 4;
      height: 64px;

      // Inject menu on desktop style
      :global(menu) {
        all: unset;
        display: flex;
        list-style: none;
      }

      :global(menu > li > a) {
        text-decoration: none;
        color: var(--color-primary);
        font-weight: 600;

        height: 64px;
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        justify-content: center;
        align-content: stretch;
        align-items: center;
        padding: 0 var(--size-vertical-base);
        border-left: 1px solid transparent;
        border-right: 1px solid transparent;

        font-size: var(--font-size-sm);
      }

      :global(menu > li > a:hover) {
        border-left: 1px solid var(--color-primary);
        border-right: 1px solid var(--color-primary);
      }
    }
  }
</style>
