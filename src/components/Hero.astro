---
import Container from "./Container.astro";
import Grid from "./Grid.astro";
import Head3D from "./Head3D.astro";
---

<main>
  <Container hasPadding>
    <Grid class="hero">
      <div class="model-3d">
        <Head3D />
      </div>
      <div class="introduction">
        <h1>
          Hi! I'm Konrad, an ADHD-powered web developer from Warsaw passionate
          about technology, hacking, 3D printing, and all things geeky. Here, I
          share projects, tips, and ideas fueled by curiosity and a love for
          innovation. Dive in and explore the chaos of creativity!
        </h1>
      </div>
    </Grid>
  </Container>
</main>
<style lang="scss">
  @use "sass:map";
  @use "../styles/breakpoints" as breakpoints;
  @use "../styles/typography" as typography;
  @use "../styles/spacing" as spacing;

  main {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
  }

  .model-3d {
    grid-column: span 6;
  }

  .introduction {
    margin: 0 0 0 0;
    grid-column: span 6;
  }

  .introduction h1 {
    @include typography.font("lg");
  }

  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    .hero {
      margin: spacing.space(8) 0 0 0;
    }

    .model-3d {
      place-content: center;
      grid-column-start: 1;
      grid-column-end: 2;
    }

    .introduction {
      grid-column-start: 2;
      grid-column-end: 7;
    }

    .introduction h1 {
      @include typography.font("2xl");
    }
  }
</style>
