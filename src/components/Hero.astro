---
import Container from "./Container.astro";
import Grid from "./Grid.astro";
---

<main>
  <Container hasPadding>
    <Grid>
      <div class="introduction">
        <h1>
          Hi! I'm Konrad, an ADHD-powered web developer from Warsaw passionate
          about technology, hacking, 3D printing, and all things geeky. Here, I
          share projects, tips, and ideas fueled by curiosity and a love for
          innovation. Dive in and explore the chaos of creativity!
        </h1>
      </div>
    </Grid>
  </Container>
</main>
<style lang="scss">
  @use "sass:map";
  @use "../styles/breakpoints";

  main {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
  }

  .introduction {
    grid-column: span 6;
  }

  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    .introduction {
      margin: 64px 0 0 0;
      grid-column-start: 2;
      grid-column-end: 7;
    }

    .introduction h1 {
      font-size: var(--font-size-2xl);
      font-weight: 400;
      line-height: var(--size-horizontal-base-2x);
    }
  }
</style>
