---
import Container from "./layout/Container.astro";
import Grid from "./layout/Grid.astro";
import Head3D from "./3d/Head3D/Head3D.astro";
---

<div class="hero-container">
  <Container hasPadding>
    <Grid class="hero">
      <div class="model-3d">
        <div>
          <Head3D />
        </div>
      </div>
      <div class="introduction">
        <h1>
          Hi! I'm Konrad, an ADHD-powered web developer from Warsaw passionate
          about technology, hacking, 3D printing, and all things geeky. Here, I
          share projects, tips, and ideas fueled by curiosity and a love for
          innovation. Dive in and explore the chaos of creativity!
        </h1>
      </div>
    </Grid>
  </Container>
</div>
<style lang="scss">
  @use "sass:map";
  @use "../styles/breakpoints" as breakpoints;
  @use "../styles/typography" as typography;
  @use "../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  .hero-container {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
  }

  .model-3d {
    margin: spacing.space(4) 0 0 0;
    grid-column: span 6;

    > div {
      display: flex;
      justify-content: center;

      :global(#head-3d) {
        max-width: 66%;
      }
    }
  }

  .introduction {
    margin: 0 0 0 0;
    grid-column: span 6;
  }

  .introduction h1 {
    @include typography.font("lg");
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    .hero {
      margin: spacing.space(8) 0 0 0;
    }

    .model-3d {
      place-content: center;
      grid-column-start: 1;
      grid-column-end: 2;
      margin: 0;

      > div {
        display: initial;

        :global(#head-3d) {
          max-width: 100%;
        }
      }
    }

    .introduction {
      grid-column-start: 2;
      grid-column-end: 7;
    }

    .introduction h1 {
      @include typography.font("2xl");
    }
  }
</style>
