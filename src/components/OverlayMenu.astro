---
import Menu from "./Menu.astro";
import ThemeButtonClassic from "./ThemeButtonClassic.astro";
const { ...props } = Astro.props;
---

<nav id="overlay-menu" class="overlay-menu" aria-hidden="true" {...props}>
  <Menu />
  <ThemeButtonClassic />
</nav>
<style lang="scss">
  @use "sass:map";
  @use "../styles/breakpoints";

  /* ==========================================
   Global/Mobile
  =========================================== */
  #overlay-menu {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    background-color: var(--color-secondary);
    z-index: 3;
    position: fixed;
    top: 63px;
    border: solid 1px var(--color-primary);
    transition: transform 0.5s ease-out;
    padding-left: var(--size-horizontal-base);

    // Inject menu on mobile
    :global(menu) {
      all: unset;

      box-sizing: border-box;
      display: block;
      list-style: none;
    }

    :global(menu > li > a) {
        text-decoration: none;
        color: var(--color-primary);
        font-size: var(--font-size-lg);
        font-weight: 600;


        height: 48px;
        display: block;
        line-height: 48px;

        // border-bottom: 1px solid var(--color-primary);
    }
  }

  #overlay-menu[aria-hidden="true"] {
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-100%);
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    #overlay-menu {
      display: none;
    }
  }
</style>
<script>
  import { effect } from "nanostores";
  import { isMenuOpen } from "../stores/menuStore.js";

  const menu = document.getElementById("overlay-menu");

  if (!menu) {
    throw new Error("Menu element not found");
  };

  menu.addEventListener("transitionend", (e) => {
    const target = e.target as HTMLElement;
    const isHidden = target.getAttribute("aria-hidden");

    if (isHidden === "true") {
      menu.style.visibility = "hidden";
    }
  });

  // Listen for changes to the store
  effect(isMenuOpen, (isOpen) => {
    if (isOpen) {
      menu.style.visibility = "visible";
      menu.setAttribute("aria-hidden", "false");
    } else {
      menu.setAttribute("aria-hidden", "true");
    }
  });
</script>
