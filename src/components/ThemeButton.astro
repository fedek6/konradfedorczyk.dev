---
import IconBtn from "./IconBtn.astro";
const { ...props } = Astro.props;
---

<IconBtn
  class="theme-button"
  data-theme-button
  aria-label="Change page theme"
  {...props}
/>
<style>
  .theme-button {
    image-rendering: pixelated;
    background-size: auto 100%;
    background-position: 48px 0px;
  }

  .theme-button[data-theme="light"] {
    background-image: url("../assets/dark-theme-btn.png");
    background-color: var(--color-secondary);
    animation: play-dark 6s steps(11) infinite;
    transition: opacity .5s steps(5);
    border: solid 1px var(--color-primary);
  }
  .theme-button[data-theme="light"]:hover {
    opacity: .5;
  }

  .theme-button[data-theme="dark"] {
    background-image: url("../assets/light-theme-btn.png");
    background-color: var(--color-secondary);
    animation: play-light 4s steps(7) infinite;
    border: solid 1px var(--color-secondary);
    transition: border .5s steps(5);
  }

  .theme-button[data-theme="dark"]:hover {
    border: solid 1px var(--color-primary);
  }

  @keyframes play-dark {
    0% {
      /* Starts at the first frame */
      background-position: 0px 0px;
    }
    50%,
    100% {
      background-position: calc(-11 * 48px) 0px;
    }
  }

  @keyframes play-light {
    0% {
      /* Starts at the first frame */
      background-position: 0px 0px;
    }
    50%,
    100% {
      background-position: calc(-7 * 48px) 0px;
    }
  }
</style>
<script>
  import { theme } from "../stores/themeStore";
  import { effect } from "nanostores";

  const buttons = document.querySelectorAll("[data-theme-button]");

  buttons.forEach((button) => {
    button.addEventListener("click", () =>
      theme.set(theme.get() === "dark" ? "light" : "dark"),
    );
  });

  effect(theme, (theme) => {
    buttons.forEach((button) => {
      button.setAttribute("data-theme", theme);
    });
  });
</script>
