---
const { as: Tag = "h5", ...props } = Astro.props;
---

<Tag {...props}><slot /></Tag>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  * {
    @include typography.font("base", "sm", "bold");
    margin-bottom: spacing.space(4);
  }
</style>
