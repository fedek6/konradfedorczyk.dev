---
type Props = {
  reverse?: boolean;
} & astroHTML.JSX.HTMLAttributes;

const { reverse, ...props } = Astro.props;
---

<div class:list={[{ "reversed": reverse}, "lozenge"]} {...props}>
  <slot />
</div>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  .lozenge {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    @include typography.font("sm", "base", "normal");
    border: solid 1px var(--color-primary);
    border-radius: 8px;
    padding: 4px;
  }

  .reversed {
    border: solid 1px var(--color-primary);
    background-color: var(--color-primary);
    color: var(--color-secondary);
  }
</style>
