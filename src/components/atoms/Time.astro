---
interface Props {
  date: Date;
}

const { date, ...props } = Astro.props;

const month = `${date.getMonth() + 1}`.padStart(2, "0");
const day = `${date.getDate()}`.padStart(2, "0");
const humanDate = `${date.getFullYear()}-${month}-${day}`;
---

<time datetime={date.toISOString()} {...props} data-nice-date>{humanDate}</time>
<script>
  import { formatDate } from "../../utils/time.ts";

  document.addEventListener("astro:page-load", async () => {
    const container = document.querySelectorAll("time[data-nice-date]");

    container.forEach((el) => {
      if (el instanceof HTMLTimeElement) {
        const date = new Date(el.dateTime);
        const humanDate = formatDate(date);
        el.innerText = humanDate;
      }
    });
  });
</script>
