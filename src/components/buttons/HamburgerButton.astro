---
const { ...props } = Astro.props;
import IconHamburger from "../icons/IconHamburger.astro";
import IconClose from "../icons/IconClose.astro";
---

<button
  data-menu-button
  class="menu-button"
  aria-label="Open menu"
  aria-expanded="false"
  aria-controls="overlay-menu"
  aria-haspopup="true"
  {...props}
>
  <IconHamburger class="menu-closed" />
  <IconClose class="menu-opened" />
</button>
<style>
  .menu-button {
    all: unset;
    height: 64px;
    width: 64px;
    background-color: transparent;

    border-right: solid 1px var(--color-primary);
    border-left: solid 1px var(--color-primary);

    box-sizing: border-box;
  }

  .menu-button[aria-expanded="true"] {
    padding: 16px;

    .menu-closed {
      display: none;
    }
  }
  .menu-button[aria-expanded="false"] {
    padding: 20px;

    .menu-opened {
      display: none;
    }
  }
</style>
<script>
  import { isMenuOpen } from "../../stores/menuStore.js";
  import { effect } from "nanostores";
  const buttons = document.querySelectorAll("[data-menu-button]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => isMenuOpen.set(!isMenuOpen.get()));
  });

  effect(isMenuOpen, (isOpen) => {
    buttons.forEach((button) => {
      button.setAttribute("aria-expanded", isOpen ? "true" : "false");
    });
  });
</script>
