---
type Props = {
  isReversed?: boolean;
} & astroHTML.JSX.AnchorHTMLAttributes;

const { isReversed, ...props } = Astro.props;
---

<a class:list={[ { 'reversed': isReversed }]} {...props}><slot /></a>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  a {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    @include typography.link;
    border: solid 1px var(--color-primary);
    background-color: transparent;
    height: spacing.space(6);
    border-radius: 8px;
    gap: 4px;

    @include typography.font("sm", "base", "bold");
  }

  a:hover {
    background-color: var(--color-primary);
    color: var(--color-secondary);
    text-decoration: none;
  }

  .reversed {
    border: solid 1px var(--color-primary);
    background-color: var(--color-primary);
    @include typography.link('--color-secondary');
  }
</style>
