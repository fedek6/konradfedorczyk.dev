---
import Container from "../layout/Container.astro";
import Grid from "../layout/Grid.astro";
import CenterContent from "../layout/CenterContent.astro";
import ContactMenu from "../navigation/ContactMenu.astro";
import MiscMenu from "../navigation/MiscMenu.astro";
---

<footer>
  <CenterContent>
    <Container hasPadding>
      <Grid class="footer-grid">
        <div class="info">
          <p>
            <span class="icon-heart" aria-hidden="true"></span> Handcrafted using&nbsp;
            <a href="https://astro.build/blog/astro-720/" target="_blank"
              >Astro</a>
          </p>
        </div>
        <div class="contact footer-menu">
          <ContactMenu />
        </div>
        <div class="misc footer-menu">
          <MiscMenu />
        </div>
      </Grid>
    </Container>
  </CenterContent>
</footer>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  footer {
    padding-top: spacing.space(5);
    background-color: var(--color-primary);
    color: var(--color-secondary);

    height: spacing.$footer-height-mobile;
  }

  .footer-grid {
    row-gap: spacing.space(2);
  }

  .info {
    grid-column: span 6;
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: center;
    order: 3;

    @include typography.font("xs", "base");
    // margin-bottom: spacing.space(6);

    a {
      text-decoration: none;
      color: var(--color-secondary);

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .icon-heart {
    height: 24px;
    width: 24px;
    display: inline-block;
    background-image: var(--icon-heart);
    background-size: contain;
    background-repeat: no-repeat;
    image-rendering: pixelated;
    vertical-align: middle;
    margin: 0 0.1em;
  }

  .contact {
    grid-column: span 6;

    margin-bottom: spacing.space(2);
    border-bottom: 1px solid var(--color-secondary);

    order: 1;
  }

  .misc {
    grid-column: span 6;

    // border-top: 1px solid var(--color-secondary);
    border-bottom: 1px solid var(--color-secondary);

    order: 2;

    margin-bottom: spacing.space(3);
  }

  .footer-menu {
    :global(menu) {
      list-style: none;
      padding: 0 0;

      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: end;
      width: 100%;
    }

    :global(menu li:not(:last-of-type)) {
      display: block;
      border-right: 1px solid var(--color-secondary);
    }

    :global(menu a) {
      @include typography.link("--color-secondary");
      @include typography.font("xs", "base");
      display: block;
      padding: spacing.space(1) spacing.space(2);
    }
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    footer {
      height: spacing.$footer-height-desktop;
      padding-top: spacing.space(6);
    }

    .info {
      grid-column: span 2;
      margin: 0 0;
      @include typography.font("sm", "base");
      order: 0;
      align-items: start;
    }

    .contact {
      grid-column: span 4;
      order: 1;
    }

    .misc {
      order: 2;
    }

    .footer-menu {
      :global(menu a) {
        @include typography.font("sm", "base");
      }
    }
  }
</style>
