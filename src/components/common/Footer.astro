---
import Container from "../layout/Container.astro";
import Grid from "../layout/Grid.astro";
import CenterContent from "../layout/CenterContent.astro";
import ContactMenu from "../navigation/ContactMenu.astro";
---

<footer>
  <CenterContent>
    <Container hasPadding>
      <Grid class="footer-grid">
        <div class="info">
          <p>Handcrafted with <span class="icon-heart" aria-hidden="true"></span> using
          &nbsp;<a href="https://astro.build/blog/astro-720/" target="_blank"
            >Astro</a></p>
        </div>
        <div class="contact">
          <ContactMenu />
        </div>
      </Grid>
    </Container>
  </CenterContent>
</footer>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  footer {
    padding-top: spacing.space(4);
    background-color: var(--color-primary);
    color: var(--color-secondary);
    @include typography.font("sm", "base");
    height: spacing.$footer-height-mobile;
  }

  .footer-grid {
    row-gap: spacing.space(2);
  }

  .info {
    grid-column: span 6;
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: center;

    a {
      text-decoration: none;
      color: var(--color-secondary);

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .icon-heart {
    height: 24px;
    width: 24px;
    display: inline-block;
    background-image: var(--icon-heart);
    background-size: contain;
    background-repeat: no-repeat;
    image-rendering: pixelated;
    vertical-align: middle;
    margin: 0 0.1em;
  }

  .contact {
    grid-column: span 6;



    :global(menu) {
      list-style: none;
      padding: 0 0;

      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      width: 100%;
    }

    :global(menu li:not(:last-of-type)) {
      display: block;
      border-right: 1px solid var(--color-secondary);
    }

    :global(menu a) {
      @include typography.link("--color-secondary");
      @include typography.font("sm", "base");
      display: block;
      padding: spacing.space(1) spacing.space(2);

    }
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    footer {
      height: spacing.$footer-height-desktop;
    }

    .info {
      grid-column: span 3;
    }

    .contact {
      grid-column: span 3;
    }
  }
</style>
