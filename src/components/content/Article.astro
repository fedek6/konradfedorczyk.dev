---
import { type CollectionEntry } from "astro:content";
import ContentHeader from "../organisms/ContentHeader.astro";
import LinkButton from "../buttons/LinkButton.astro";
import IconArrowRight from "../icons/IconArrowRight.astro";

interface Props {
  entry: CollectionEntry<"articles">;
}

const { entry } = Astro.props;
const year = entry.data.pubDate.getFullYear();
const permalink = new URL(`/articles/${year}/${entry.id}`, Astro.url.origin)
  .href;
---

<article>
  <ContentHeader
    title={entry.data.title}
    date={new Date(entry.data.pubDate)}
    href={permalink}
    template="full"
  />
  <section>
    {entry.data.description}
  </section>
  <footer>
    <LinkButton href={permalink}
      >Read <IconArrowRight style="height: 32px;" /></LinkButton
    >
  </footer>
</article>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  article {
    grid-column: span 12;
    display: grid;
    grid-template-columns: subgrid;
    // margin-bottom: 200px;
    border-left: solid 2px var(--color-primary);
    padding-left: spacing.space(2);

    // border-top: solid 1px var(--color-primary);
  }

  :global(header) {
    grid-column: span 12;
  }

  section {
    grid-column: span 12;
    margin-bottom: spacing.space(4);
  }

  footer {
    grid-column: span 12;
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    :global(header) {
      grid-column: span 6;
    }

    section {
      grid-column: span 6;
    }

    footer {
      grid-column: span 6;
    }

    article {
      padding-left: 0;
      border-left: none;
    }
  }
</style>
