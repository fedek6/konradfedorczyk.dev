---
import Container from "../layout/Container.astro";
import Grid from "../layout/Grid.astro";
import DividedHeader from "../typography/DividedHeader.astro";
import CenterContent from "../layout/CenterContent.astro";
import { getCollection } from "astro:content";
import ContentList from "../navigation/ContentList.astro";
import { renderingConfig } from "../../config/rendering";
import { metaConfig } from "../../config/meta";
import LinkButton from "../buttons/LinkButton.astro";

const contentMapper = <T extends { data: { pubDate: Date } }>(
  content: T[],
): T[] => {
  return [...content]
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, renderingConfig.numItemsOnContentList);
};

// Collections
const notesCollection = await getCollection("notes");
const articlesCollection = await getCollection("articles");
const projectsCollection = await getCollection("projects");

const notes = contentMapper(notesCollection);
const isNotesCategoryExpendable =
  notesCollection.length > renderingConfig.numItemsOnContentList;
const articles = contentMapper(articlesCollection);
const isArticlesCategoryExpendable =
  articlesCollection.length > renderingConfig.numItemsOnContentList;
const projects = contentMapper(projectsCollection);
const isProjectsCategoryExpendable =
  projectsCollection.length > renderingConfig.numItemsOnContentList;
---

<CenterContent>
  <Container hasPadding>
    <Grid class="content-demo">
      <section class="content-list">
        <header class="content-header">
          <DividedHeader>{metaConfig.categories.notes.title}</DividedHeader>
          <p>
            {metaConfig.categories.notes.description}
          </p>
        </header>
        <ContentList
          entries={notes.map((note) => ({
            title: note.data.title,
            id: note.id,
          }))}
          slug={metaConfig.categories.notes.slug}
        />
        {
          isNotesCategoryExpendable && (
            <footer class="content-footer">
              <LinkButton href={metaConfig.categories.notes.slug}>
                Show More
              </LinkButton>
            </footer>
          )
        }
      </section>
      <section class="content-list">
        <header class="content-header">
          <DividedHeader>{metaConfig.categories.articles.title}</DividedHeader>
          <p>
            {metaConfig.categories.articles.description}
          </p>
        </header>
        <ContentList
          entries={articles.map((note) => ({
            title: note.data.title,
            id: note.id,
          }))}
          slug={metaConfig.categories.articles.slug}
        />
        {
          isArticlesCategoryExpendable && (
            <footer class="content-footer">
              <LinkButton href={metaConfig.categories.notes.slug}>
                Show More
              </LinkButton>
            </footer>
          )
        }
      </section>
      <section class="content-list">
        <header class="content-header">
          <DividedHeader>{metaConfig.categories.projects.title}</DividedHeader>
          <p>
            {metaConfig.categories.projects.description}
          </p>
        </header>
        <ContentList
          entries={projects.map((note) => ({
            title: note.data.title,
            id: note.id,
          }))}
          slug={metaConfig.categories.projects.slug}
        />
        {
          isProjectsCategoryExpendable && (
            <footer class="content-footer">
              <LinkButton href={metaConfig.categories.notes.slug}>
                Show More
              </LinkButton>
            </footer>
          )
        }
      </section>
      <div class="content-link">
        {
          isNotesCategoryExpendable && (
            <LinkButton href={metaConfig.categories.notes.slug}>
              Show More
            </LinkButton>
          )
        }
      </div>
      <div class="content-link">        {
          isArticlesCategoryExpendable && (
            <LinkButton href={metaConfig.categories.articles.slug}>
              Show More
            </LinkButton>
          )
        }</div>
      <div class="content-link">        {
          isProjectsCategoryExpendable && (
            <LinkButton href={metaConfig.categories.projects.slug} aria-label="Show more from category articles">
              Show More
            </LinkButton>
          )
        }</div>
    </Grid>
  </Container>
</CenterContent>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  .content-demo {
    margin: spacing.space(8) 0 spacing.space(8) 0;
  }

  .content-list {
    grid-column: span 6;
    margin-bottom: spacing.space(4);
  }

  .content-header {
    margin-bottom: spacing.space(3);

    :global(> div:first-child) {
      margin-bottom: spacing.space();
    }

    :global(p) {
      @include typography.font("sm", "base");
      @include typography.hyphenation;
    }
  }

  .content-footer {
    margin-top: spacing.space(4);
  }

  .content-link {
    display: none;
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    .content-demo {
      margin: spacing.space(9) 0 spacing.space(9) 0;
      row-gap: spacing.space(2);
    }

    .content-list {
      grid-column: span 2;
      margin-bottom: 0;
    }

    .content-header {
      margin-bottom: spacing.space(4);

      :global(> div:first-child) {
        margin-bottom: spacing.space(2);
      }

      :global(p) {
        @include typography.font("base");
      }
    }

    .content-footer {
      display: none;
    }

    .content-link {
      display: initial;
      grid-column: span 2;
      margin-bottom: spacing.space(8);
    }
  }
</style>
