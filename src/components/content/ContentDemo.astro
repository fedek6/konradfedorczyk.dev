---
import Container from "../layout/Container.astro";
import Grid from "../layout/Grid.astro";
import DividedHeader from "../typography/DividedHeader.astro";
import CenterContent from "../layout/CenterContent.astro";
import { getCollection } from "astro:content";
import ContentList from "../navigation/ContentList.astro";
import { renderingConfig } from "../../config/rendering";
import { metaConfig } from "../../config/meta";

const contentMapper = <T extends { data: { pubDate: Date } }>(
  content: T[],
): T[] => {
  return [...content]
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, renderingConfig.numItemsOnContentList);
};

// Collections
const notes = contentMapper(await getCollection("notes"));
const articles = contentMapper(await getCollection("articles"));
const projects = contentMapper(await getCollection("projects"));
---

<CenterContent>
  <Container hasPadding>
    <Grid class="content-demo">
      <section class="content-list">
        <header class="content-header">
          <DividedHeader>{metaConfig.categories.notes.title}</DividedHeader>
          <p>
            {metaConfig.categories.notes.description}
          </p>
        </header>
        <ContentList
          entries={notes.map((note) => ({
            title: note.data.title,
            id: note.id,
          }))}
          slug={metaConfig.categories.notes.slug}
        />
      </section>
      <section class="content-list">
        <header class="content-header">
          <DividedHeader>{metaConfig.categories.articles.title}</DividedHeader>
          <p>
            {metaConfig.categories.articles.description}
          </p>
        </header>
        <ContentList
          entries={articles.map((note) => ({
            title: note.data.title,
            id: note.id,
          }))}
          slug={metaConfig.categories.articles.slug}
        />
      </section>
      <section class="content-list">
        <header class="content-header">
          <DividedHeader>{metaConfig.categories.projects.title}</DividedHeader>
          <p>
            {metaConfig.categories.projects.description}
          </p>
        </header>
        <ContentList
          entries={projects.map((note) => ({
            title: note.data.title,
            id: note.id,
          }))}
          slug={metaConfig.categories.projects.slug}
        />
      </section>
    </Grid>
  </Container>
</CenterContent>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  .content-demo {
    margin: spacing.space(8) 0 0 0;
  }

  .content-list {
    grid-column: span 6;
  }

  .content-header {
    margin-bottom: spacing.space(3);

    :global(> div:first-child) {
      margin-bottom: spacing.space();
    }

    :global(p) {
      @include typography.font("sm", "base");
      @include typography.hyphenation;
    }
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    .content-demo {
      margin: spacing.space(9) 0 0 0;
    }

    .content-list {
      grid-column: span 2;
    }

    .content-header {
      margin-bottom: spacing.space(4);

      :global(> div:first-child) {
        margin-bottom: spacing.space(2);
      }

      :global(p) {
        @include typography.font("base");
      }
    }
  }
</style>
