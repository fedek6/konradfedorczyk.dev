---
interface Entry {
  title: string;
  id: string;
}

interface Props {
  entries: Entry[];
  slug: string;
}

const { entries, slug } = Astro.props;
---

<ul>
  {
    entries.map((entry) => (
      <li>
        <a href={`/${slug}/${entry.id}/`}>
          <h2>{entry.title}</h2>
        </a>
      </li>
    ))
  }
</ul>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  ul {
    list-style: none;
    margin: 0;
    padding: 0;

    li h2 {
      @include typography.font("base");
    }
  }
</style>
