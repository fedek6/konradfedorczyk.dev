---
import { type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CenterContent from "../layout/CenterContent.astro";
import Container from "../layout/Container.astro";
import Grid from "../layout/Grid.astro";
import SideTocContainer from "../layout/SideTocContainer.astro";
import type { TocEntry } from "../navigation/ExternalTableOfContents.astro";
import TableOfContents from "../navigation/ExternalTableOfContents.astro";
import DividedHeader from "../typography/DividedHeader.astro";
import Article from "./Article.astro";

interface Props {
  category: {
    title: string;
    description: string;
  };
  toc: TocEntry[];
  currentHref: string;
  currentTitle: string;
  articles: CollectionEntry<"articles">[];
}

const { category, toc, currentHref, currentTitle, articles } = Astro.props;
const title = `${category.title} from ${currentTitle}`;
---

<Layout title={title}>
  <CenterContent>
    <Container hasPadding>
      <Grid class="content-list">
        <SideTocContainer class="toc" variant="right">
          <TableOfContents
            toc={toc}
            currentHref={currentHref}
            title="Archives"
          />
        </SideTocContainer>
        <div class="content-header">
          <DividedHeader as="h1">
            {category.title} from {currentTitle}
          </DividedHeader>
          <p>{category.description}</p>
        </div>
        <div class="content">
          {articles.map((article) => <Article entry={article} />)}
        </div>
      </Grid>
    </Container>
  </CenterContent>
</Layout>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  .content-list {
    margin: spacing.space(8) 0 spacing.space(8) 0;
  }

  .content-header {
    grid-column: span 12;
    margin-bottom: spacing.space(2);
    :global(h1) {
      @include typography.font("3xl", "xs", "bold");
      margin-bottom: spacing.space(3);
    }

    :global(p) {
      @include typography.font("lg", "base", "normal");
    }

    :global(> div) {
      padding-top: spacing.space(2);
    }
  }

  .content {
    grid-column: span 12;

    :global(article) {
      margin-bottom: spacing.space(8);
    }
  }

  .group-container {
    margin-bottom: spacing.space(10);

    // Year header
    :global(> div:first-child) {
      scroll-margin-top: calc(65px + spacing.space(8));
      grid-column: span 2;
      margin-bottom: spacing.space(3);
    }

    // Note card
    :global(> div:nth-child(2) > div > article) {
      margin-bottom: spacing.space(10);
    }
  }

  // Toc has different look on mobile
  .toc {
    // display: none;
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    .toc {
      grid-column: span 2;
      grid-row: 1 / 3;
      position: static;
      display: initial;

      :global(> nav) {
        position: sticky;
        top: calc(65px + 64px);
      }
    }

    .content-header {
      grid-column: span 6;
      margin-bottom: spacing.space(6);

      :global(h1) {
        @include typography.font("6xl", "xs", "bold");
        margin-bottom: spacing.space(3);
      }

      :global(> div) {
        padding-top: spacing.space(2);
      }

      :global(p) {
        @include typography.font("lg", "base", "normal");
      }
    }

    .content {
      grid-column: 3 / span 10;
      display: grid;
      grid-template-columns: subgrid;

      :global(article) {
        margin-bottom: spacing.space(8);
      }
    }

    .group-container {
      grid-column: span 10;
      margin-bottom: spacing.space(10);

      display: grid;
      grid-template-columns: subgrid;

      // Year header
      :global(> div:first-child) {
        scroll-margin-top: calc(65px + spacing.space(8));
        grid-column: span 2;
        margin-bottom: spacing.space(4);
      }

      :global(> div:nth-child(2)) {
        grid-column: span 10;
      }
    }
  }
</style>
