---
interface Props {
  template?: "simple" | "full";
}

const { template = "simple" } = Astro.props;
---

<div class:list={["content-style", template]}>
  <slot />
</div>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  .content-style {
    :global(pre) {
      @include typography.font("xs", "base", "bold");
      padding: spacing.space(2) spacing.space(2);
      border: solid 1px var(--color-primary);
      border-radius: 8px;
      margin-bottom: spacing.space(2);
    }

    :global([data-toc-observe]) {
      scroll-margin-top: calc(65px + spacing.space(4));
    }

    :global(p) {
      @include typography.font("base", "2xl", "normal");
      margin-bottom: spacing.space(2);
    }

    :global(h2) {
      @include typography.font("xl", "sm", "bold");
      margin-bottom: spacing.space(2);
    }

    :global(h3) {
      @include typography.font("lg", "sm", "bold");
      margin-bottom: spacing.space();
    }

    :global(h4) {
      @include typography.font("base", "sm", "bold");
      margin-bottom: spacing.space(1);
      text-transform: uppercase;
    }

    :global(* + h1, h2, h3, h4) {
      margin-top: spacing.space(5);
    }

    :global(a) {
      text-decoration: none;
      color: var(--color-accent);

      display: inline-block;

      &:hover {
        text-decoration: underline;
      }

      &::after {
        content: "";
        text-decoration: none;
        width: 18px;
        height: 18px;
        display: inline-block;
        vertical-align: middle;
        margin-left: 4px;
        margin-right: 4px;

        background-image: var(--icon-link);
        image-rendering: pixelated;
        background-repeat: no-repeat;
        background-position: center;
        background-size: 100% auto;
      }
    }
  }

  .content-style.full {
    :global(p:first-of-type) {
      // font-style: italic;
      @include typography.font("lg", "2xl", "normal");
      margin-bottom: spacing.space(6);
      // padding-left: spacing.space(2);
      font-style: italic;
      // border-bottom: solid 1px var(--color-primary);
      // padding-bottom: spacing.space(2);
      // border-top: solid 1px var(--color-primary);
      // padding-top: spacing.space(2)
    }
  }
  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    .content-style.full {
      :global(p:first-of-type) {
        font-style: italic;
        @include typography.font("lg", "2xl", "normal");
        margin-bottom: spacing.space(6);
              border-bottom: solid 1px var(--color-primary);
      padding-bottom: spacing.space(2);
      }

      :global(* + h1, h2, h3, h4) {
        margin-top: spacing.space(6);
      }
    }
  }
</style>
