---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro";

interface Props extends HTMLAttributes<HTMLImageElement> {
  src: ImageMetadata | string;
  alt: string;
}

const { src, alt, ...rest } = Astro.props;
const isOptimizable = typeof src === "object" && src !== null && "width" in src;
---

<figure class="content-image">
  {
    isOptimizable ? <Image src={src} alt={alt} {...rest} /> : <img src={src} alt={alt} {...rest} />
  }
  {alt && <figcaption class="content-image__caption">{alt}</figcaption>}
</figure>
<style lang="scss">
  @use "../../styles/spacing" as spacing;
  @use "../../styles/typography" as typography;

  .content-image {
    margin: spacing.space(6) 0;

    img,
    picture {
      display: block;
      max-width: 100%;
      height: auto;
    }

    &__caption {
      margin-top: spacing.space(2);
      color: var(--color-accent);
      @include typography.font("sm", "sm", "normal");
      font-style: italic;
    }
  }
</style>
