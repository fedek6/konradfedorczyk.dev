---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt, ...rest } = Astro.props;
---

<figure class="content-image">
  {
    <Image
      src={src}
      alt={alt}
      sizes="(max-width: 750px) 100vw, 750px"
      widths={[320, 480, 750]}
      {...rest}
    />
  }
  {alt && <figcaption class="content-image__caption">{alt}</figcaption>}
</figure>
<style lang="scss">
  @use "../../styles/spacing" as spacing;
  @use "../../styles/typography" as typography;

  .content-image {
    margin: spacing.space(6) 0;

    img,
    picture {
      display: block;
      max-width: 100%;
      height: auto;
    }

    &__caption {
      margin-top: spacing.space(2);
      color: var(--color-accent);
      @include typography.font("sm", "sm", "normal");
      font-style: italic;
    }
  }
</style>
