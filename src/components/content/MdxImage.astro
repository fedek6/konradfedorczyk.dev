---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt, ...rest } = Astro.props;
---

<figure
  class="content-image"
  data-image-lightbox-trigger
  data-alt={alt}
  role="button"
  tabindex="0"
  aria-label={`View ${alt || "image"} in full screen`}
>
  {
    <Image
      src={src}
      alt={alt}
      sizes="(max-width: 750px) 100vw, 750px"
      widths={[320, 480, 750]}
      {...rest}
    />
  }
  {alt && <figcaption class="content-image__caption">{alt}</figcaption>}
  <span class="content-image__zoom" aria-hidden="true">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
      <line x1="11" y1="8" x2="11" y2="14"></line>
      <line x1="8" y1="11" x2="14" y2="11"></line>
    </svg>
  </span>
</figure>

<style lang="scss">
  @use "../../styles/spacing" as spacing;
  @use "../../styles/typography" as typography;

  .content-image {
    position: relative;
    margin: spacing.space(4) 0;
    cursor: zoom-in;

    img,
    picture {
      display: block;
      max-width: 100%;
      height: auto;
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    &:hover img,
    &:hover picture {
      transform: scale(1.02);
    }

    /* &:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 4px;
      border-radius: 6px;
    }*/

    &__caption {
      margin-top: spacing.space(1);
      color: var(--color-primary);
      @include typography.font("sm", "sm", "normal");
      font-style: italic;
    }

    &__zoom {
      position: absolute;
      top: spacing.space(2);
      right: spacing.space(2);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      width: 44px;
      height: 44px;
      color: var(--color-primary);
      background: var(--color-secondary);
      border: 1px solid var(--color-primary);
      // border-radius: 999px;
      // box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
      opacity: 0;
      transform: scale(0.85) translateY(4px);
      transition:
        opacity 0.25s ease,
        transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      pointer-events: none;

      svg {
        width: 22px;
        height: 22px;
      }
    }

    &:hover &__zoom,
    &:focus-visible &__zoom {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .content-image {
      img,
      picture,
      &__zoom {
        transition: none;
      }
    }
  }
</style>
