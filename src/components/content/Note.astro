---
import { render, type CollectionEntry } from "astro:content";
import { noteComponents } from "./ComponentMap";
import H2 from "../atoms/H2.astro";
import Time from "../atoms/Time.astro";
import ContentStyle from "../content/ContentStyle.astro";

interface Props {
  entry: CollectionEntry<"notes">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<article>
  <header>
    <Time date={new Date(entry.data.pubDate)} />
    <H2 as="h1">{entry.data.title}</H2>
  </header>
  <section>
    <ContentStyle>
      <Content />
    </ContentStyle>
  </section>
</article>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  article {
    border-radius: 8px;
    border: solid 1px var(--color-primary);
    padding: spacing.space(3) spacing.space(4) spacing.space(5) spacing.space(4);

    // transition: all 0.5s ease-in-out;
  }

  /* article:hover {
    background: var(--color-primary);
    color: var(--color-secondary );
  } */

  header {
    margin-bottom: spacing.space(3);

    :global(time) {
      @include typography.font("sm", "base", "bold");
      display: block;
    }
  }
</style>
