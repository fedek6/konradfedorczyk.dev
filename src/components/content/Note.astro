---
import { render, type CollectionEntry } from "astro:content";
import { noteComponents } from "./ComponentMap";
import ContentStyle from "./ContentStyle.astro";

interface Props {
  entry: CollectionEntry<"notes">;
}

const a = {
  p: Fragment,
};

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<article>
  <header>
    <h1>{entry.data.title}</h1>
    <ContentStyle>
      <time datetime="2025-07-14">{entry.data.pubDate}</time>
    </ContentStyle>
  </header>
  <section>
    <Content components={noteComponents} />
  </section>
</article>
