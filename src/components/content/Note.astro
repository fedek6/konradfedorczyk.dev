---
import { render, type CollectionEntry } from "astro:content";
import H2 from "../atoms/H2.astro";
import Time from "../atoms/Time.astro";
import ContentStyle from "../content/ContentStyle.astro";
import ContentHeader from "../organisms/ContentHeader.astro";

interface Props {
  entry: CollectionEntry<"notes">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<article>
  <ContentHeader title={entry.data.title} date={new Date(entry.data.pubDate)} />
  <section>
    <ContentStyle>
      <Content />
    </ContentStyle>
  </section>
</article>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  article {
    border-radius: 8px;
    border: solid 1px var(--color-primary);
    padding: spacing.space(2) spacing.space(2) spacing.space(4)  spacing.space(2);

    // transition: all 0.5s ease-in-out;
  }

  /* article:hover {
    background: var(--color-primary);
    color: var(--color-secondary );
  } */

  header {
    margin-bottom: spacing.space(3);

    :global(time) {
      @include typography.font("sm", "base", "bold");
      display: block;
    }
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    article {
      border-radius: 8px;
      border: solid 1px var(--color-primary);
      padding: spacing.space(3) spacing.space(4) spacing.space(5)
        spacing.space(4);

      // transition: all 0.5s ease-in-out;
    }
  }
</style>
