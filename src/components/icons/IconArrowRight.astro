---
/**
 * Automatically converted from a PNG
 * @url https://www.sprite-ai.art/tools/png-to-svg
 */
const { ...props } = Astro.props;
---

<div {...props} data-icon>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 16 16"
    shape-rendering="crispEdges"
  >
    <rect x="12" y="6" width="1" height="1" fill="currentColor"></rect>
    <rect x="12" y="7" width="2" height="1" fill="currentColor"></rect>
    <rect x="1" y="8" width="14" height="1" fill="currentColor"></rect>
    <rect x="12" y="9" width="2" height="1" fill="currentColor"></rect>
    <rect x="12" y="10" width="1" height="1" fill="currentColor"></rect>
  </svg>
</div>
<style>
  div {
    image-rendering: pixelated;
  }
  div > svg {
    height: 100%;
    width: auto;
  }
</style>
