---
import Grid from "../../components/layout/Grid.astro";
import Breadcrumb, { type BreadcrumbItem } from "./Breadcrumb.astro";

type Props = {
  items: BreadcrumbItem[];
  marginTop?: "md" | "sm";
  marginBottom?: "md" | "sm";
} & astroHTML.JSX.HTMLAttributes;

const { items, marginTop = "md", marginBottom = "md", ...props } = Astro.props;
---

<Grid {...props}
  ><Breadcrumb
    items={items}
    class:list={["breadcrumbs", `mt-${marginTop}`, `mb-${marginBottom}`]}
  /></Grid
>

<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;
  /* ==========================================
   Global/Mobile
  =========================================== */
  .breadcrumbs {
    grid-column: span 12;
  }

  .breadcrumbs.mt-sm {
    margin-top: spacing.space(4);
  }

  .breadcrumbs.mt-md {
    margin-top: spacing.space(8);
  }

  .breadcrumbs.mb-sm {
    margin-bottom: spacing.space(2);
  }

  .breadcrumbs.mb-md {
    margin-bottom: spacing.space(3);
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    .breadcrumbs {
      grid-column: 3 / 10;
    }
  }
</style>
