---
import DividedHeader from "../typography/DividedHeader.astro";

export type TocEntry = {
  title: string;
  href: string;
};

interface Props {
  toc: TocEntry[];
}

const { toc } = Astro.props;
---

<nav aria-label="Table of contents">
  <DividedHeader as="h3">Table of contents</DividedHeader>
  <ul>
    {
      toc.map((entry) => (
        <li>
          <a href={entry.href} data-toc-scroll-to-content>
            {entry.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const link = event.target.closest<HTMLAnchorElement>("[data-toc-scroll-to-content]");
    if (!link) return;

    const url = new URL(link.href, document.baseURI);
    if (!url.hash || url.origin !== window.location.origin) return;

    event.preventDefault();

    const id = url.hash.slice(1);
    const target = document.getElementById(id);
    if (!target) return;

    target.scrollIntoView({
      behavior: "smooth",
      block: "start",
      inline: "nearest",
    });

    window.dispatchEvent(new HashChangeEvent("hashchange"));
  });
</script>
