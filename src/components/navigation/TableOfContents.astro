---
export type TocEntry = {
  title: string;
  href: string;
};

interface Props {
  toc: TocEntry[];
}

const { toc, ...props } = Astro.props;
---

<nav data-toc {...props}>
  <h3 id="menu-title">Table of contents</h3>
  <ul>
    {
      toc.map((entry) => (
        <li>
          <a href={entry.href} data-toc-scroll-to-content>
            {entry.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  nav {
    :global(> div) {
      margin-bottom: spacing.space(2);
    }
  }

  nav[aria-hidden="true"] {
    visibility: hidden;
  }

  h3 {
    @include typography.font("lg", "base", "bold");
  }

  ul {
    list-style: none;
    padding: 0 0 0 spacing.space(3);
    margin: 0 0;
  }

  a {
    @include typography.link();
    display: inline-block;
  }

  a[aria-current="true"] {
    // border: solid 1px #000;
    text-decoration: underline;
  }
  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    h3 {
      border-top: solid 1px var(--color-primary);      @include typography.font("lg", "base", "bold");
      padding: spacing.space(1) 0 0 0;
    }
  }
</style>
<script>
  let observer: IntersectionObserver;

  /*
   * Scroll links delegation.
   */
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const link = event.target.closest<HTMLAnchorElement>(
      "[data-toc-scroll-to-content]",
    );
    if (!link) return;

    const url = new URL(link.href, document.baseURI);
    if (!url.hash || url.origin !== window.location.origin) return;

    event.preventDefault();

    const id = url.hash.slice(1);
    const target = document.getElementById(id);
    if (!target) return;

    target.scrollIntoView({
      behavior: "smooth",
      block: "start",
      inline: "nearest",
    });

    window.dispatchEvent(new HashChangeEvent("hashchange"));
  });

  document.addEventListener("astro:page-load", () => {
    const toc = document.querySelector("[data-toc]");

    if (toc) {
      const entries =
        document.querySelectorAll<HTMLElement>("[data-toc-observe]");

      observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute("id");
              toc
                .querySelectorAll('[aria-current="true"]')
                .forEach((el) => el.setAttribute("aria-current", "false"));
              toc
                .querySelector(`a[href='#${id}']`)
                ?.setAttribute("aria-current", "true");
            }
          }
        },
        { rootMargin: "-20px 0px -80% 0px", threshold: 0 },
      );
      entries.forEach((a) => observer.observe(a));
    }
  });

  document.addEventListener("astro:before-swap", async () => {
    observer?.disconnect();
  });
</script>
