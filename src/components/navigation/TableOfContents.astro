---
import DividedHeader from "../typography/DividedHeader.astro";

export type TocEntry = {
  title: string;
  href: string;
};

interface Props {
  toc: TocEntry[];
}

const { toc } = Astro.props;
---

<nav aria-label="Table of contents" data-toc>
  <DividedHeader as="h3">Table of contents</DividedHeader>
  <ul>
    {
      toc.map((entry) => (
        <li>
          <a href={entry.href} data-toc-scroll-to-content>
            {entry.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  a[aria-current="true"] {
    border: solid 1px #000;
  }
</style>
<script>
  let observer: IntersectionObserver;

  /*
   * Scroll links delegation.
   */
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const link = event.target.closest<HTMLAnchorElement>(
      "[data-toc-scroll-to-content]",
    );
    if (!link) return;

    const url = new URL(link.href, document.baseURI);
    if (!url.hash || url.origin !== window.location.origin) return;

    event.preventDefault();

    const id = url.hash.slice(1);
    const target = document.getElementById(id);
    if (!target) return;

    target.scrollIntoView({
      behavior: "smooth",
      block: "start",
      inline: "nearest",
    });

    window.dispatchEvent(new HashChangeEvent("hashchange"));
  });

  document.addEventListener("astro:page-load", () => {
    const toc = document.querySelector("[data-toc]");

    if (toc) {
      const entries =
        document.querySelectorAll<HTMLElement>("[data-toc-observe]");

      observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute("id");
              toc
                .querySelectorAll('[aria-current="true"]')
                .forEach((el) => el.setAttribute("aria-current", "false"));
              toc
                .querySelector(`a[href='#${id}']`)
                ?.setAttribute("aria-current", "true");
            }
          }
        },
        { rootMargin: "-20px 0px -80% 0px", threshold: 0 },
      );
      entries.forEach((a) => observer.observe(a));
    }
  });

  document.addEventListener("astro:before-swap", async () => {
    observer?.disconnect();
  });
</script>
