---
const { as: Tag = 'h2', ...props } = Astro.props;
---
<div {...props}>
  <Tag><slot /></Tag>
</div>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints";
  @use "../../styles/typography";
  @use "../../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */

  div {
    border-top: solid 1px var(--color-primary);
  }

  h1 {
    @include typography.font("3xl", "base", "bold");
    padding: spacing.space(1) 0 0 0;
  }

  h2 {
    @include typography.font("xl", "base", "bold");
    padding: spacing.space(1) 0 0 0;
  }

  h3 {
    @include typography.font("lg", "base", "bold");
    padding: spacing.space(1) 0 0 0;
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    h3 {
      padding: spacing.space(1) 0 0 0;
      @include typography.font("lg", "base", "bold");
    }
  }
</style>
