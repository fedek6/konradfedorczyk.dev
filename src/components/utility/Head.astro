---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { capitalize } from "../../utils/content";
import { metaConfig } from "../../config/meta";

export interface Props {
  pageName: string;
  title?: string;
  seoTitle?: string;
  description?: string;
  ogTitle?: string;
  ogImage?: string;
  ogImageAlt?: string;
  rawTitle?: boolean;
  ogType?: string;
  publishedTime?: Date | string;
  schema?: Record<string, unknown>;
}

const {
  title = metaConfig.pageName,
  seoTitle = metaConfig.pageName,
  description = "",
  ogTitle,
  ogImage,
  ogImageAlt = "",
  pageName,
  rawTitle = false,
  ogType = "website",
  publishedTime,
  schema,
  ...props
} = Astro.props;

const pageTitle = rawTitle ? title : `${capitalize(title)} – ${pageName}`;
const ogTitleFinal = ogTitle ?? pageTitle;
const siteOrigin = String(Astro.site ?? Astro.url.origin).replace(/\/+$/, "");
const ogImageUrl = ogImage ?? `${siteOrigin}/og-image.jpg`;
const publishedIso = publishedTime
  ? new Date(publishedTime).toISOString()
  : undefined;
---

<title>{pageTitle}</title>
<meta charset="utf-8" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="canonical" href={Astro.url} />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="viewport" content="width=device-width" />
{
  description && <meta name="description" content={description} />
}
<meta property="og:site_name" content={pageName} />
<meta property="og:title" content={ogTitleFinal} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
{
  description && <meta property="og:description" content={description} />
}
<meta property="og:image" content={ogImageUrl} />
{
  ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />
}
{
  publishedIso && (
    <meta property="article:published_time" content={publishedIso} />
  )
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitleFinal} />
{
  description && (
    <meta name="twitter:description" content={description} />
  )
}
<meta name="twitter:image" content={ogImageUrl} />
{
  ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />
}
{
  schema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
  )
}
<Font cssVariable="--hanken-grotesk" preload />
<ClientRouter />
