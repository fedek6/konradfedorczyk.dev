---
import CenterContent from "../../components/layout/CenterContent.astro";
import { Image } from "astro:assets";
import Container from "../../components/layout/Container.astro";
import Grid from "../../components/layout/Grid.astro";
import DividedHeader from "../../components/typography/DividedHeader.astro";
import Layout from "../../layouts/Layout.astro";
import ContentStyle from "./../../components/content/ContentStyle.astro";
import testPhoto from "./portret_konrad_fedorczyk.jpg";
import horizontalPhoto from "./konrad-fedorczyk-horizontal.jpg";
import verticalPhoto from "./konrad-fedorczyk-vertical.jpg";
import MdxImage from "../../components/content/Image.astro";
---

<Layout title="about">
  <CenterContent>
    <Container hasPadding>
      <Grid class="special-content">
        <header>
          <DividedHeader as="h1">About</DividedHeader>
          <p>
            They say the hardest thing is writing about yourself. I'll do my
            best to explain who I am and what this website is all about in just
            a few words.
          </p>
        </header>
        <div class="content-block">
          <ContentStyle template="simple" variant="block">
            <h2>Who am I?</h2>
            <p>
              Well, hello! My name is Konrad Fedorczyk. I'm a software developer
              with too many years of experience. My first ever computer was a <a
                target="_blank"
                href="https://en.wikipedia.org/wiki/Commodore_64"
                >Commodore 64</a
              >. I still remember the mysterious "<strong>?SYNTAX ERROR</strong
              >" message on a blue background when I first tried to do something
              in <a target="_blank" href="https://en.wikipedia.org/wiki/BASIC"
                >BASIC</a
              >.
            </p>

            <p>
              The delayed 8-bit era in Poland ended for me when I got my
              almighty <a
                href="https://en.wikipedia.org/wiki/Amiga_500"
                target="_blank">Amiga 500</a
              > (around 1997). When I saw what this 16-bit beast, with an additional
              512K of RAM, could do, I knew it was my calling...
            </p>

            <p>
              My journey into professional computing truly began in 2000, as
              Poland stood on the cusp of the internet revolution. After getting
              my first PC, the natural next step was mastering HTML and PHP —
              and the rest is history.
            </p>
          </ContentStyle>
        </div>
        <div class="content-block wide mobile-image">
          <MdxImage
            src={verticalPhoto}
            alt="Konrad Fedorczyk in New York City"
            sizes="(max-width: 1528px) 100vw, 1528px"
            widths={[320, 480, 1528]}
            caption="A snapshot from NYC, circa 2021. Traveling is an incredible adventure, but this was around the time I realized I needed to get my act together."
          />
        </div>
        <div class="content-block wide desktop-image">
          <MdxImage
            src={horizontalPhoto}
            alt="Konrad Fedorczyk in New York City"
            sizes="(max-width: 1528px) 100vw, 1528px"
            widths={[320, 480, 1528]}
            caption="A snapshot from NYC, circa 2021. Traveling is an incredible adventure, but this was around the time I realized I needed to get my act together."
          />
        </div>
        <div class="content-block">
          <ContentStyle template="simple" variant="block">
            <h3>My late diagnosis&hellip;</h3>
            <p>
              All my life I've been struggling with long-term projects. I've had
              multiple hobbies, changing interests almost every two weeks. I've
              gone from street art to military history, through photography, and
              even a brief stint in a band (I sucked at it). I was always
              searching for that next dopamine hit, only to abandon everything
              once the initial excitement wore off.
            </p>
            <p>
              A recent <a
                href="https://adhduk.co.uk/about-adhd/"
                target="_blank">ADHD</a
              > diagnosis has changed my approach to hobbies and work. For the first
              time, the pieces of my life have finally clicked into place, offering
              an explanation for my lifelong struggle.
            </p>
            <p>
              That is why I decided to create this website. I want to share my
              experiences with work and finding a work-life balance, in the hope
              that I can help others facing similar challenges.
            </p>
          </ContentStyle>
        </div>
      </Grid>
    </Container>
  </CenterContent>
</Layout>
<style lang="scss">
  @use "sass:map";
  @use "../../styles/breakpoints" as breakpoints;
  @use "../../styles/typography" as typography;
  @use "../../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  .special-content {
    // row-gap: 0;
  }

  .desktop-image {
    display: none;
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    .special-content {
      margin-top: spacing.space(8);
    }

    header {
      grid-column: 2 / span 8;
      margin-bottom: spacing.space(3);

      :global(h1) {
        @include typography.font("9xl", "xs", "bold");
        margin-bottom: spacing.space(3);
      }

      > p {
        // font-style: italic;
        @include typography.font("2xl", "base", "normal");

      }
    }

    .content-block {
      grid-column: 4 / span 6;
    }

    .content-block.wide {
      grid-column: 1 / span 12;
    }

    .content-block.left {
      grid-column: 1 / span 8;
    }

    .mobile-image {
      display: none;
    }

    .desktop-image {
      display: initial;
    }
  }
</style>
