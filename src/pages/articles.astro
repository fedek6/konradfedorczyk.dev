---
import Layout from "../layouts/Layout.astro";
import Container from "../components/layout/Container.astro";
import Grid from "../components/layout/Grid.astro";
import CenterContent from "../components/layout/CenterContent.astro";
import DividedHeader from "../components/typography/DividedHeader.astro";
import TableOfContents from "../components/navigation/TableOfContents.astro";
import { metaConfig } from "../config/meta";
import { getCollection } from "astro:content";
import Masonry from "../components/layout/Masonry.astro";
import Note from "../components/content/Note.astro";
import { groupByYear, extractYears } from "../utils/content";
import SideTocContainer from "../components/layout/SideTocContainer.astro";

const config = metaConfig.categories.articles;
const collection = await getCollection("articles");
const years = extractYears(collection);
const toc = years.map((year) => ({
  title: `${year}`,
  href: `/articles/${year}`,
}));
---

<Layout title="articles">
  <CenterContent>
    <Container hasPadding>
      <Grid class="notes-list">
        <SideTocContainer class="toc" variant="right">
          <TableOfContents toc={toc} />
        </SideTocContainer>
        <div class="content-header">
          <DividedHeader as="h1">{config.title}</DividedHeader>
          <p>{config.description}</p>
        </div>
        <div class="content">ss</div>
      </Grid>
    </Container></CenterContent
  >
</Layout>
<style lang="scss">
  @use "sass:map";
  @use "../styles/breakpoints" as breakpoints;
  @use "../styles/typography" as typography;
  @use "../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  .notes-list {
    margin: spacing.space(8) 0 0 0;
  }

  .content-header {
    grid-column: span 12;
    margin-bottom: spacing.space(2);

  }

  .content {
    // display: none;
    grid-column: span 12;
  }

  .group-container {
    margin-bottom: spacing.space(10);

    // Year header
    :global(> div:first-child) {
      scroll-margin-top: calc(65px + spacing.space(8));
      grid-column: span 2;
      margin-bottom: spacing.space(3);
    }

    // Note card
    :global(> div:nth-child(2) > div > article) {
      margin-bottom: spacing.space(10);
    }
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    .toc {
      grid-column: span 2;
      grid-row: 1 / 3;
      position: static;

      :global(> nav) {
        position: sticky;
        top: calc(65px + 64px);
      }
    }

    .content-header {
      grid-column: span 4;
      margin-bottom: spacing.space(2);
    }

    .content {
      grid-column: 3 / span 10;
      display: grid;
      grid-template-columns: subgrid;

      :global(article) {
        margin-bottom: spacing.space(4);
      }
    }

    .group-container {
      grid-column: span 10;
      margin-bottom: spacing.space(10);

      display: grid;
      grid-template-columns: subgrid;

      // Year header
      :global(> div:first-child) {
        scroll-margin-top: calc(65px + spacing.space(8));
        grid-column: span 2;
        margin-bottom: spacing.space(4);
      }

      :global(> div:nth-child(2)) {
        grid-column: span 10;
      }
    }
  }
</style>

</style>
