---
import { getCollection } from "astro:content";
import ContentList from "../../components/content/ContentList.astro";
import { metaConfig } from "../../config/meta";
import { extractYears, sortByDateDesc } from "../../utils/content";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const years = [
    ...new Set(articles.map((n) => n.data.pubDate.getFullYear())),
  ].sort();

  return years.map((year) => ({
    params: { year: String(year) },
    props: {
      articles: articles.filter((n) => n.data.pubDate.getFullYear() === year),
    },
  }));
}

const { year } = Astro.params;
const { articles } = Astro.props;

const collection = await getCollection("articles");
const years = extractYears(collection);
const toc = years.map((y) => ({
  title: `${y}`,
  href: `/articles/${y}`,
}));

const currentHref = `/articles/${year}`;
---

<ContentList
  category={metaConfig.categories.articles}
  toc={toc}
  currentHref={currentHref}
  currentTitle={String(year)}
  articles={sortByDateDesc(articles)}}
/>
