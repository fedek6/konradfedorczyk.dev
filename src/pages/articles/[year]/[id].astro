---
import { getCollection, getEntry, render } from "astro:content";
import AdvancedContent from "../../../components/content/AdvancedContent.astro";
import CenterContent from "../../../components/layout/CenterContent.astro";
import Container from "../../../components/layout/Container.astro";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
  const collection = await getCollection("articles");
  return collection.map((article) => ({
    params: { id: article.id, year: `${article.data.pubDate.getFullYear()}` },
  }));
}

const { id, year } = Astro.params;
const entry = await getEntry("articles", id);
if (!entry) throw new Error(`Note "${id}" not found`);
const { Content } = await render(entry);
---
<Layout
  title={entry.data.title}
  description={entry.data.description}
  seoTitle={entry.data.title}
>
  <CenterContent>
    <Container hasPadding>
      <AdvancedContent entry={entry} backLink={`/articles/${year}`} backLinkText="articles"><Content /></AdvancedContent>
    </Container>
  </CenterContent>
</Layout>
