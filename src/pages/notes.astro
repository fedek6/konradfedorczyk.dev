---
import Layout from "../layouts/Layout.astro";
import Container from "../components/layout/Container.astro";
import Grid from "../components/layout/Grid.astro";
import CenterContent from "../components/layout/CenterContent.astro";
import DividedHeader from "../components/typography/DividedHeader.astro";
import TableOfContents from "../components/navigation/TableOfContents.astro";
import { metaConfig } from "../config/meta";
import { getCollection } from "astro:content";
import Masonry from "../components/layout/Masonry.astro";
import Note from "../components/content/Note.astro";
import { groupByYear } from "../utils/content";
import { render } from "astro:content";

const config = metaConfig.categories.notes;

const collection = await getCollection("notes");
//const rendered = await Promise.all(collection.map((note) => render(note)));

const notesGrouped = groupByYear(collection);
const toc = notesGrouped.map(([year]) => ({
  title: year,
  href: `#${year}`,
}));

// console.log(notesGrouped[0][1]);
const items = ["One", "Two", "Three", "Four", "Five"];
---

<Layout title="notes">
  <CenterContent>
    <Container hasPadding>
      <Grid class="notes-list">
        <div class="toc">
          <TableOfContents toc={toc} />
        </div>
        <div class="content-header">
          <DividedHeader as="h1">{config.title}</DividedHeader>
          <p>{config.description}</p>
        </div>
        <div class="content">
          {
            notesGrouped.map(([year, notes]) => (
              <div class="group-container">
                <DividedHeader as="h2" id={year} data-toc-observe>
                  {year}
                </DividedHeader>
                <div>
                  <Masonry>
                    <Fragment slot="items">
                      {notes?.map((note) => (
                        <>
                          <Note entry={note} />
                        </>
                      ))}
                    </Fragment>
                  </Masonry>
                </div>
              </div>
            ))
          }

          <div class="group-container">
            <DividedHeader as="h2" id="2026" data-toc-observe
              >2026</DividedHeader
            >
            <div>
              <Masonry>
                <Fragment slot="items">

                </Fragment>
              </Masonry>
            </div>
          </div>
          <div class="group-container">
            <DividedHeader as="h2" id="2025" data-toc-observe
              >2025</DividedHeader
            >
            <Masonry>
              <Fragment slot="items">
                {items.map((item) => <div>{item}</div>)}
              </Fragment>
            </Masonry>
          </div>
        </div>
      </Grid>
    </Container>
  </CenterContent>
</Layout>
<style lang="scss">
  @use "sass:map";
  @use "../styles/breakpoints" as breakpoints;
  @use "../styles/typography" as typography;
  @use "../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  .notes-list {
    margin: spacing.space(8) 0 0 0;
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    .toc {
      grid-column: span 2;
      grid-row: 1 / 3;
      background-color: rgba(255, 0, 0, 0.2);

      :global(> nav) {
        position: sticky;
        top: calc(65px + 64px);
      }

      // grid-row: span 4;
    }

    .content-header {
      grid-column: span 4;

      > p {
        @include typography.font("base");
      }
    }

    .content {
      grid-column: 3 / span 10;
      display: grid;
      grid-template-columns: subgrid;
    }

    .group-container {
      grid-column: span 10;

      display: grid;
      grid-template-columns: subgrid;

      background-color: rgba(255, 0, 0, 0.2);
      // height: 50vh;

      :global(> div:first-child) {
        scroll-margin-top: calc(65px + spacing.space(8));
        grid-column: span 2;
      }

      :global(> div:nth-child(2)) {
        grid-column: span 10;
      }
    }
  }
</style>
