---
import Layout from "../layouts/Layout.astro";
import Container from "../components/layout/Container.astro";
import Grid from "../components/layout/Grid.astro";
import CenterContent from "../components/layout/CenterContent.astro";
import DividedHeader from "../components/typography/DividedHeader.astro";
import TableOfContents from "../components/navigation/TableOfContents.astro";
import { metaConfig } from "../config/meta";
import { getCollection } from "astro:content";
import Masonry from "../components/layout/Masonry.astro";
import Note from "../components/content/Note.astro";
import { groupByYear } from "../utils/content";

const config = metaConfig.categories.notes;
const collection = await getCollection("notes");

const notesGrouped = groupByYear(collection);
const toc = notesGrouped.map(([year]) => ({
  title: year,
  href: `#${year}`,
}));
---

<Layout title="notes">
  <CenterContent>
    <Container hasPadding>
      <Grid class="notes-list">
        <div class="toc">
          <TableOfContents toc={toc} />
        </div>
        <div class="content-header">
          <DividedHeader as="h1">{config.title}</DividedHeader>
          <p>{config.description}</p>
        </div>
        <div class="content">
          {
            notesGrouped.map(([year, notes]) => (
              <div class="group-container">
                <DividedHeader as="h2" id={year} data-toc-observe>
                  {year}
                </DividedHeader>
                <div>
                  <Masonry>
                    <Fragment slot="items">
                      {notes?.map((note) => (
                        <>
                          <Note entry={note} />
                        </>
                      ))}
                    </Fragment>
                  </Masonry>
                </div>
              </div>
            ))
          }
        </div>
      </Grid>
    </Container>
  </CenterContent>
</Layout>
<style lang="scss">
  @use "sass:map";
  @use "../styles/breakpoints" as breakpoints;
  @use "../styles/typography" as typography;
  @use "../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  .notes-list {
    margin: spacing.space(8) 0 0 0;
  }

  .toc {
    grid-column: span 0;
    grid-row: 1;
    // visibility: hidden;
    // display: none;
    position: fixed;
    left: -90%;
  }

  .content-header {
    grid-column: span 12;
    margin-bottom: spacing.space(2);
  }

  .content {
    // display: none;
    grid-column: span 12;
  }

  .group-container {
    margin-bottom: spacing.space(10);

    // Year header
    :global(> div:first-child) {
      scroll-margin-top: calc(65px + spacing.space(8));
      grid-column: span 2;
      margin-bottom: spacing.space(3);
    }

    // Note card
    :global(> div:nth-child(2) > div > article) {
      margin-bottom: spacing.space(4);
    }
  }

  /* ==========================================
   Desktop
  =========================================== */
  @media (min-width: map.get(breakpoints.$breakpoints, "lg")) {
    .toc {
      grid-column: span 2;
      grid-row: 1 / 3;
      position: static;
      visibility: visible;

      :global(> nav) {
        position: sticky;
        top: calc(65px + 64px);
      }
    }

    .content-header {
      grid-column: span 4;
      margin-bottom: spacing.space(2);
    }

    .content {
      grid-column: 3 / span 10;
      display: grid;
      grid-template-columns: subgrid;

      :global(article) {
        margin-bottom: spacing.space(4);
      }
    }

    .group-container {
      grid-column: span 10;
      margin-bottom: spacing.space(10);

      display: grid;
      grid-template-columns: subgrid;

      // Year header
      :global(> div:first-child) {
        scroll-margin-top: calc(65px + spacing.space(8));
        grid-column: span 2;
        margin-bottom: spacing.space(4);
      }

      :global(> div:nth-child(2)) {
        grid-column: span 10;
      }
    }
  }
</style>
