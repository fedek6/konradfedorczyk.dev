---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/layout/Container.astro";
import CenterContent from "../../components/layout/CenterContent.astro";
import ContentStyle from "../../components/content/ContentStyle.astro";
import ContentHeader from "../../components/organisms/ContentHeader.astro";
import { getCollection, render } from "astro:content";
import { getEntry } from "astro:content";
import Grid from "../../components/layout/Grid.astro";

export async function getStaticPaths() {
  const collection = await getCollection("notes");
  return collection.map((note) => ({
    params: { id: note.id },
  }));
}

const { id } = Astro.params;
const entry = await getEntry("notes", id);
if (!entry) throw new Error(`Note "${id}" not found`);
// const entry = collection.find((note) => note.id === id)!;

const { Content } = await render(entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  seoTitle={entry.data.title}
>
  <CenterContent>
    <Container hasPadding>
      <Grid class="note">
        <article>
          <ContentHeader
            title={entry.data.title}
            date={new Date(entry.data.pubDate)}
          />
          <section>
            <ContentStyle>
              <Content />
            </ContentStyle>
          </section>
          <footer>
            <a class="back-link" href="/notes">&larr; back to notes</a>
          </footer>
        </article>
      </Grid>
    </Container>
  </CenterContent>
</Layout>
<style lang="scss">
  @use "../../styles/spacing" as spacing;

  /* ==========================================
   Global/Mobile
  =========================================== */
  .note {
    margin: spacing.space(8) 0 0 0;
  }

  article {
    grid-column: span 12;
    border-top: solid 1px var(--color-primary);
    padding-top: spacing.space(2);
  }

  .note-single {
    // max-width: 72ch;
    margin: 0 auto;

    article,
    header {
      margin-bottom: spacing.space(4);
    }

    .back-link {
      display: inline-block;
      margin-top: spacing.space(6);
      text-decoration: none;
      color: var(--color-accent);
    }
  }
</style>
