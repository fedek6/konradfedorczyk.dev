---
import { getCollection, getEntry, render } from "astro:content";
import AdvancedContent from "../../components/content/AdvancedContent.astro";
import ContentImage from "../../components/content/MdxImage.astro";
import CenterContent from "../../components/layout/CenterContent.astro";
import Container from "../../components/layout/Container.astro";
import StandardizedBreadcrumbs from "../../components/navigation/StandardizedBreadcrumbs.astro";
import { renderingConfig } from "../../config/rendering";
import Layout from "../../layouts/Layout.astro";
import { truncate } from "../../utils/content";

export async function getStaticPaths() {
  const collection = await getCollection("projects");
  return collection.map((project) => ({
    params: { id: project.id },
  }));
}

const { id } = Astro.params;
const entry = await getEntry("projects", id);
if (!entry) throw new Error(`Project "${id}" not found`);
const { Content, headings } = await render(entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  seoTitle={entry.data.title}
>
  <CenterContent>
    <Container hasPadding>
      <StandardizedBreadcrumbs
        items={[
          { label: "Projects", href: "/projects" },
          {
            label: truncate(
              entry.data.title,
              renderingConfig.truncateBreadCrumbTitle,
            ),
          },
        ]}
        marginTop="sm"
        marginBottom="sm"
      />
      <AdvancedContent
        entry={entry}
        backLink="/projects"
        backLinkText="projects"
        headings={headings}><Content components={{ img: ContentImage }} /></AdvancedContent
      >
    </Container>
  </CenterContent>
</Layout>
